@page "/abroad"
@inject IJSRuntime JS

<PageTitle>Study Abroad - CeyBEC Abroad</PageTitle>

<main style="background:#f8fafc;display:block;">

    <!-- ═══════ HERO BANNER ═══════ -->
    <section style="position:relative;background:#002147;padding-top:4rem;padding-bottom:7rem;border-bottom-left-radius:3rem;border-bottom-right-radius:3rem;overflow:hidden;margin-top:0;">
        <div style="position:absolute;inset:0;background:rgba(0,33,71,0.72);z-index:1;"></div>
        <div style="position:absolute;inset:0;opacity:0.35;background:radial-gradient(circle at top right,#00b4d8,#002147,#002147);z-index:1;"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(to top,#002147 0%,rgba(0,33,71,0.2) 60%,transparent 100%);z-index:1;"></div>
        <img src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=2071&auto=format&fit=crop"
             style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;mix-blend-mode:luminosity;z-index:0;" alt="" />

        <div style="position:relative;z-index:10;max-width:1400px;margin:0 auto;padding:0 2rem;text-align:center;">
            <div class="abroad-hero-in" style="margin-bottom:0.75rem;">
                <span style="color:#00b4d8;font-weight:700;letter-spacing:0.22em;font-size:0.75rem;text-transform:uppercase;border-bottom:1px solid rgba(0,180,216,0.3);padding-bottom:0.4rem;display:inline-block;">
                    CeyBEC Abroad — Your Global Gateway
                </span>
            </div>
            <h1 class="abroad-hero-in font-serif font-bold text-white" style="font-size:clamp(2.2rem,5vw,3.8rem);margin-bottom:1rem;line-height:1.2;">
                Welcome to <span style="background:linear-gradient(to right,#00b4d8,#ffffff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">CeyBEC Abroad</span>
            </h1>
            <p class="abroad-hero-in" style="color:#cbd5e1;font-size:clamp(0.95rem,1.8vw,1.1rem);max-width:44rem;margin:0 auto 1.75rem;">
                Where Global Dreams Begin — And Borders End.
            </p>
            <div class="abroad-hero-in" style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
                <a href="#services"
                   style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.8rem 2rem;background:#00b4d8;color:#002147;font-weight:700;font-size:0.82rem;letter-spacing:0.08em;text-transform:uppercase;border-radius:9999px;text-decoration:none;box-shadow:0 8px 20px rgba(0,180,216,0.3);transition:transform 0.2s;"
                   onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                    <i data-lucide="compass" style="width:1rem;height:1rem;"></i> Explore Services
                </a>
                <a href="#countries"
                   style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.8rem 2rem;background:rgba(255,255,255,0.12);color:white;font-weight:700;font-size:0.82rem;letter-spacing:0.08em;text-transform:uppercase;border-radius:9999px;text-decoration:none;border:1px solid rgba(255,255,255,0.3);backdrop-filter:blur(4px);"
                   onmouseover="this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">
                    <i data-lucide="globe" style="width:1rem;height:1rem;"></i> Our Destinations
                </a>
            </div>
        </div>
    </section>

    <!-- ═══════ INTRO + ABOUT ═══════ -->
    <section style="max-width:1400px;width:100%;margin:-4rem auto 5rem;padding:0 2rem;box-sizing:border-box;position:relative;z-index:20;">
        <div style="background:white;border-radius:2.5rem;padding:clamp(2rem,5vw,4rem);box-shadow:0 25px 60px rgba(0,0,0,0.08);border:1px solid #eef2f7;">
            <div class="abroad-two-col" style="display:grid;grid-template-columns:1fr 1.55fr;gap:3rem;align-items:center;">

                <!-- visual side -->
                <div class="abroad-fade" style="position:relative;">
                    <div style="position:absolute;inset:-0.75rem;background:linear-gradient(135deg,#00b4d8,#002147);border-radius:2rem;opacity:0.12;z-index:0;"></div>
                    <img src="images/bg_10.jpg" alt="CeyBEC Abroad campus"
                         style="position:relative;z-index:1;width:100%;border-radius:1.75rem;object-fit:cover;max-height:380px;box-shadow:0 20px 50px rgba(0,33,71,0.18);" />
                    <!-- Stats pill -->
                    <div style="position:absolute;bottom:-1.25rem;left:50%;transform:translateX(-50%);z-index:10;background:linear-gradient(135deg,#002147,#0a3060);border-radius:9999px;padding:0.65rem 2rem;display:flex;gap:2rem;box-shadow:0 8px 24px rgba(0,33,71,0.3);white-space:nowrap;">
                        <div style="text-align:center;">
                            <div style="font-size:1.25rem;font-weight:800;color:#00b4d8;">850+</div>
                            <div style="font-size:0.68rem;color:rgba(255,255,255,0.7);text-transform:uppercase;letter-spacing:0.1em;">Institutions</div>
                        </div>
                        <div style="width:1px;background:rgba(255,255,255,0.15);"></div>
                        <div style="text-align:center;">
                            <div style="font-size:1.25rem;font-weight:800;color:#00b4d8;">10+</div>
                            <div style="font-size:0.68rem;color:rgba(255,255,255,0.7);text-transform:uppercase;letter-spacing:0.1em;">Countries</div>
                        </div>
                    </div>
                </div>

                <!-- copy side -->
                <div class="abroad-fade">
                    <p style="font-size:0.72rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#00b4d8;margin-bottom:0.6rem;">International Education</p>
                    <h2 class="font-serif font-bold" style="font-size:clamp(1.6rem,2.8vw,2.4rem);color:#002147;margin-bottom:1.25rem;line-height:1.2;">CeyBEC Abroad</h2>
                    <p style="color:#475569;line-height:1.8;font-size:0.97rem;margin-bottom:1rem;">
                        At CeyBEC Abroad, we are dedicated to transforming your academic aspirations into reality. As the international arm of CeyBEC Campus, we specialize in personalized guidance for students aiming to pursue higher education globally.
                    </p>
                    <p style="color:#475569;line-height:1.8;font-size:0.97rem;">
                        We have partnerships with <strong style="color:#002147;">850+ esteemed institutions</strong> across the UK, Australia, Canada, New Zealand, USA, Ireland, Dubai, Germany, France, and many other European nations.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════ COUNTRY FLAGS ═══════ -->
    <section id="countries" style="max-width:1400px;width:100%;margin:0 auto 5rem;padding:0 2rem;box-sizing:border-box;">
        <div style="text-align:center;margin-bottom:3rem;">
            <p style="font-size:0.72rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#00b4d8;margin-bottom:0.5rem;">Study Destinations</p>
            <h2 class="font-serif font-bold" style="font-size:clamp(1.6rem,3vw,2.4rem);color:#002147;">Our Expansive Global Presence</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:1.5rem;" class="country-grid">
            @foreach (var country in countries)
            {
                <div class="abroad-fade" style="background:white;border-radius:1.75rem;padding:1.75rem 1rem;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,0.06);border:1px solid #eef2f7;transition:transform 0.25s,box-shadow 0.25s;cursor:default;"
                     onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 18px 40px rgba(0,33,71,0.14)'"
                     onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.06)'">
                    <div style="width:4rem;height:4rem;margin:0 auto 1rem;border-radius:50%;overflow:hidden;border:2px solid #e2e8f0;display:flex;align-items:center;justify-content:center;background:#f8fafc;">
                        <img src="images/@country.Image" alt="@country.Name"
                             style="width:100%;height:100%;object-fit:cover;" />
                    </div>
                    <p style="font-weight:700;color:#002147;font-size:0.88rem;margin:0;">@country.Name</p>
                    <p style="color:#94a3b8;font-size:0.75rem;margin:0.2rem 0 0;">@country.Label</p>
                </div>
            }
        </div>
    </section>

    <!-- ═══════ SERVICES ═══════ -->
    <section id="services" style="background:linear-gradient(135deg,#002147,#0a3060);padding:5rem 2rem;margin:0 0 5rem;">
        <div style="max-width:1400px;margin:0 auto;">
            <div style="text-align:center;margin-bottom:3rem;">
                <p style="font-size:0.72rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#00b4d8;margin-bottom:0.5rem;">What We Offer</p>
                <h2 class="font-serif font-bold" style="font-size:clamp(1.6rem,3vw,2.4rem);color:white;">Our Services</h2>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;" class="services-grid">
                @foreach (var svc in services)
                {
                    <div class="abroad-fade" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:1.75rem;padding:2rem 1.75rem;backdrop-filter:blur(6px);transition:background 0.25s;"
                         onmouseover="this.style.background='rgba(0,180,216,0.12)'" onmouseout="this.style.background='rgba(255,255,255,0.07)'">
                        <div style="width:2.75rem;height:2.75rem;background:rgba(0,180,216,0.15);border-radius:0.875rem;display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem;border:1px solid rgba(0,180,216,0.25);">
                            <i data-lucide="@svc.Icon" style="color:#00b4d8;width:1.2rem;height:1.2rem;"></i>
                        </div>
                        <h3 style="font-weight:700;color:white;font-size:0.97rem;margin-bottom:0.6rem;">@svc.Title</h3>
                        <p style="color:rgba(255,255,255,0.65);font-size:0.88rem;line-height:1.7;margin:0;">@svc.Desc</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ═══════ UNIVERSITY PARTNERS ═══════ -->
    <section style="max-width:1400px;width:100%;margin:0 auto 5rem;padding:0 2rem;box-sizing:border-box;">
        <div style="text-align:center;margin-bottom:3rem;">
            <p style="font-size:0.72rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#00b4d8;margin-bottom:0.5rem;">Trusted Institutions</p>
            <h2 class="font-serif font-bold" style="font-size:clamp(1.6rem,3vw,2.4rem);color:#002147;">University Partners</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:1.25rem;" class="uni-grid">
            @for (int i = 1; i <= 10; i++)
            {
                var idx = i;
                <div class="abroad-fade" style="background:white;border-radius:1.5rem;padding:1.5rem;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 18px rgba(0,0,0,0.06);border:1px solid #eef2f7;min-height:90px;transition:transform 0.25s,box-shadow 0.25s;"
                     onmouseover="this.style.transform='translateY(-5px)';this.style.boxShadow='0 14px 32px rgba(0,33,71,0.12)'"
                     onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 18px rgba(0,0,0,0.06)'">
                    <img src="images/c@(idx).png" alt="University @idx"
                         style="max-height:58px;max-width:100%;object-fit:contain;" />
                </div>
            }
        </div>
    </section>

    <!-- ═══════ WHY CHOOSE + TESTIMONIALS ═══════ -->
    <section style="max-width:1400px;width:100%;margin:0 auto 6rem;padding:0 2rem;box-sizing:border-box;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start;" class="abroad-two-col">

            <!-- Why choose us -->
            <div class="abroad-fade" style="background:linear-gradient(135deg,#002147,#0a3060);border-radius:2rem;padding:2.5rem;box-shadow:0 20px 50px rgba(0,33,71,0.2);">
                <p style="font-size:0.72rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#00b4d8;margin-bottom:0.5rem;">Our Strengths</p>
                <h2 class="font-serif font-bold" style="font-size:clamp(1.4rem,2.5vw,2rem);color:white;margin-bottom:1.75rem;">Why Choose Us</h2>
                <div style="display:flex;flex-direction:column;gap:1rem;">
                    @foreach (var point in whyUs)
                    {
                        <div style="display:flex;align-items:flex-start;gap:1rem;background:rgba(255,255,255,0.06);border-radius:1rem;padding:1rem 1.25rem;border:1px solid rgba(255,255,255,0.1);">
                            <div style="width:2rem;height:2rem;background:#00b4d8;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i data-lucide="check" style="color:#002147;width:1rem;height:1rem;"></i>
                            </div>
                            <p style="color:rgba(255,255,255,0.85);font-size:0.9rem;line-height:1.6;margin:0;">@point</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Testimonials -->
            <div class="abroad-fade" style="display:flex;flex-direction:column;gap:1.5rem;">
                <p style="font-size:0.72rem;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#00b4d8;margin-bottom:0.25rem;">Student Stories</p>
                <h2 class="font-serif font-bold" style="font-size:clamp(1.4rem,2.5vw,2rem);color:#002147;margin-bottom:0.25rem;">What Our Students Say</h2>
                @foreach (var t in testimonials)
                {
                    <div style="background:white;border-radius:1.75rem;padding:1.75rem;box-shadow:0 8px 24px rgba(0,0,0,0.06);border:1px solid #eef2f7;border-left:4px solid #00b4d8;">
                        <i data-lucide="quote" style="color:#00b4d8;width:1.25rem;height:1.25rem;margin-bottom:0.75rem;display:block;"></i>
                        <p style="color:#475569;font-size:0.92rem;line-height:1.75;font-style:italic;margin-bottom:1rem;">@t.Quote</p>
                        <p style="font-weight:700;color:#002147;font-size:0.85rem;margin:0;">— @t.Author</p>
                    </div>
                }
            </div>

        </div>
    </section>

</main>

<style>
    .abroad-hero-in {
        opacity: 0;
        transform: translateY(24px);
        animation: abroadFadeUp 0.7s ease forwards;
    }
    .abroad-hero-in:nth-child(1) { animation-delay: 0.1s; }
    .abroad-hero-in:nth-child(2) { animation-delay: 0.25s; }
    .abroad-hero-in:nth-child(3) { animation-delay: 0.4s; }
    .abroad-hero-in:nth-child(4) { animation-delay: 0.55s; }

    @@keyframes abroadFadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .abroad-fade {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .abroad-fade.visible {
        opacity: 1;
        transform: translateY(0);
    }

    @@media (max-width: 1100px) {
        .country-grid { grid-template-columns: repeat(3, 1fr) !important; }
        .uni-grid     { grid-template-columns: repeat(3, 1fr) !important; }
        .services-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @@media (max-width: 700px) {
        .abroad-two-col { grid-template-columns: 1fr !important; }
        .country-grid   { grid-template-columns: repeat(2, 1fr) !important; }
        .uni-grid       { grid-template-columns: repeat(2, 1fr) !important; }
        .services-grid  { grid-template-columns: 1fr !important; }
    }
</style>

@code {
    private record Country(string Image, string Name, string Label);
    private record Service(string Icon, string Title, string Desc);
    private record Testimonial(string Quote, string Author);

    private List<Country> countries = new()
    {
        new("uk.png",           "United Kingdom", "UK"),
        new("australia.png",    "Australia",      "Australia"),
        new("canada.png",       "Canada",         "Canada"),
        new("New Zealand.png",  "New Zealand",    "New Zealand"),
        new("usa.png",          "United States",  "USA"),
        new("ireland.png",      "Ireland",        "Ireland"),
        new("uae.png",          "Dubai",          "UAE"),
        new("germany.png",      "Germany",        "Germany"),
        new("france.png",       "France",         "France"),
        new("europe.png",       "Europe",         "Europe"),
    };

    private List<Service> services = new()
    {
        new("target",        "Career-Focused Counselling",   "Explore countries, programs & institutions aligned with your goals."),
        new("file-text",     "University Applications",      "Application guidance, SOP writing & documentation."),
        new("shield-check",  "Study Visa Guidance",          "Visa file prep, mock interview training & compliance review."),
        new("banknote",      "'Show Money' Consultation",    "Financial readiness & compliance tips for your destination country."),
        new("plane",         "Air Ticket Booking Support",   "Affordable student fares & travel preparation guidance."),
        new("users",         "Pre/Post-Departure Support",   "Cultural orientation sessions & accommodation assistance."),
    };

    private List<string> whyUs = new()
    {
        "Extensive Global Network: 850+ partner institutions worldwide",
        "Experienced & dedicated international education counselors",
        "Comprehensive end-to-end student support",
        "Ethical & fully transparent practices",
    };

    private List<Testimonial> testimonials = new()
    {
        new("\"CeyBEC Abroad gave me more than guidance — they gave me clarity and courage. I'm now studying in Germany.\"", "Sanduni, Berlin"),
        new("\"From university selection to visa success, CeyBEC was by my side. The team truly cares.\"", "Hashen, Toronto"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("lucide.createIcons");
            await JS.InvokeVoidAsync("initAbroadPage");
        }
    }
}
